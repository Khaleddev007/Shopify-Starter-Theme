{% assign collections = section.settings.collection.products %}


<div class="featured-collection-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2>{{ section.settings.heading }}</h2>

                    {% if section.settings.subheading != blank %}
                    <p>{{ section.settings.subheading }}</p>
                    {% endif %}


                </div>
            </div>
        </div>
        <div class="row">

            {% for collection in collections %}

            <div class="col-lg-3">
                <div class="product-wrapper">
                    <div class="product-tumb">
                        {{ collection.featured_image |  image_url: width: 300 |  image_tag }}
                    </div>
                    <div class="product-info">
                        <h3>{{ collection.title }}</h3>
                        <div class="price">{{ collection.price | money }}</div>
                        <a href="{{ collection.url }}">Details</a>
                    </div>
                </div>
            </div>

            {% else %}

            {% for item in (1..8) %}

            <div class="col-lg-3">
                <div class="product-wrapper">
                    <div class="product-tumb">

                        {%- capture current -%}
                            {%- cycle 1,2,3,4 -%}
                        {%- endcapture -%}

                        {{ 'product-apparel-' | append: current |  placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                    <div class="product-info">
                        <h3>Product {{ forloop.index }}</h3>
                        <div class="price">$50</div>
                        <a href="#">Details</a>
                    </div>
                </div>
            </div>

            {% endfor %}

            {% endfor %}

        </div>
    </div>
</div>


{% schema %}
    {
        "name": "Featured Collection",
        "class": "Featured-Collection",
        "settings": [

            {
                "type" : "collection",
                "id" : "collection",
                "label" : "Featured Collection"
            },

            {
                "type" : "text",
                "id" : "heading",
                "label" : "Section Title",
                "default": "Featured Section"
            },

            {
                "type" : "richtext",
                "id" : "subheading",
                "label" : "Section Sub Title",

            }

        ],

        "presets": [
           {
             "name" : "Product Collection",
             "category" : "collection"
           }
        ]
    }
{% endschema %}

