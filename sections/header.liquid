<div class="header-section">
  {{section.settings.header_text}}

  
  <div class="logo">

  <a href="{{ shop.url }}" class="logo-wrap-box">

  {% if settings.logo != blank %}

    <img src="{{ settings.logo | image_url: width: settings.logo_width }}" alt="{{ shop.name }}">

  {% else %}
  <h2>{{ shop.name }}</h2>
  {% endif %}

  </a>

  </div>



<div class="mainmenu">

{% if section.settings.menu != blank %}

    <ul class="menu-wrapper">

 {% for link in section.settings.menu.links %}

    <li><a href="{{ link.url }}"> {{ link.title }}</a></li>

    {% if link.links.size > 0 %}

    <li class="nav-item-dropdown">

    <a href="{{ link.url }}">{{ link.title }}</a>

    <ul class="dropdown">

    

      {% for child in link.links %} 

        <li><a href="{{ child.url }}"> {{ child.title }}</a></li>

      {% endfor %}

    </ul>


    </li>

  {% endif %}


 {% endfor %}

    </ul>

{% endif %}


</div>


<a href="{{ routes.cart_url }}">Cart: {{ cart.item_count }}</a>



</div>

{% schema %}
{
  "name": "Main Header",
  "settings": [
    {
    "type": "color",
    "id": "header_bg",
    "label": "Header Background Color",
    "default": "#000000"
    },

    {
        "type": "text",
        "id": "header_text",
        "label": "Header Text",
        "default": "Header Main Text"
    },

    {
      "type": "link_list",
      "id": "menu",
      "label": "Select Menu",
      "default": "main-menu"
    }



  ]
}
{% endschema %}


